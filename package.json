{
  "name": "dsh-jiahao-mode",
  "version": "0.1.0",
  "description": "嘉豪模式：给 DeepSeek Harness 的威龙绝活哥人设插件。四条行为准则、三档嘴臭、与其它人设互斥，活照干、豪照放。",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "jiahao"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Rosynb666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rosynb666/dsh-jiahao-mode.git"
  },
  "homepage": "https://github.com/Rosynb666/dsh-jiahao-mode#readme",
  "bugs": {
    "url": "https://github.com/Rosynb666/dsh-jiahao-mode/issues"
  },
  "license": "MIT"
}
